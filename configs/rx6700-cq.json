{
  "format_version": 1,
  "tokenizer": "artifacts/tokenizer.json",
  "packed_dir": "datasets/packed/rx6700-v1",
  "run_dir": "runs/rx6700-cq-v1",
  "seed": 42,
  "sequence_length": 256,
  "block_sequences": 256,
  "sources": {
    "fineweb2_hq": { "train_tokens": 650000000, "validation_tokens": 1000000 },
    "ficbook":     { "train_tokens": 300000000, "validation_tokens": 1000000 },
    "ru_classic":  { "train_tokens":  50000000, "validation_tokens": 1000000 }
  },
  "ficbook_phase_one_tokens": 50000000,
  "model": {
    "dim": 384,
    "depth": 6,
    "heads": 4,
    "dim_qk_heads": 2048
  },
  "optimizer": {
    "micro_batch_size": 1,
    "gradient_accumulation": 32,
    "max_learning_rate": 0.0003,
    "min_learning_rate": 0.00003,
    "warmup_tokens": 10000000,
    "beta_1": 0.9,
    "beta_2": 0.95,
    "weight_decay": 0.1,
    "gradient_clip_norm": 1.0
  },
  "memory": {
    "stateful_after_tokens": 100000000,
    "chunks_per_detach": 4,
    "reset_on_document": true,
    "reset_on_work_block": true
  },
  "checkpoint_every_steps": 1000,
  "validation_every_steps": 1000,
  "validation_batches": 64,
  "log_every_steps": 10
}
